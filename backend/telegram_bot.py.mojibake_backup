        # - csat_{dialog_id}_{rating} (legacy)
        # - csat_{dialog_id}_{appeal_id}_{rating} (current)
        parts = call.data[len(CSAT_PREFIX):].split("_")
        if len(parts) not in (2, 3):
            bot.answer_callback_query(call.id, "РћС€РёР±РєР° РґР°РЅРЅС‹С…")
