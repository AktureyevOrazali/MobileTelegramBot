def _survey_employee_options(session: dict, question: dict) -> list[dict]:
    if question.get("question_type") != QUESTION_EMPLOYEE:
        return []
    operators = session.get("operators") or []
    if operators:
        return operators
    bin_value = session.get("bin")
    if bin_value:
        return database.get_bin_interacted_employees(str(bin_value))
    return []


def _send_survey_question(session: dict) -> bool:
    question = session.get("current_question")
    if not question:
        database.complete_survey_session(int(session["id"]))
        return False
    employee_options = _survey_employee_options(session, question)
    text = format_survey_question_message(
        question,
        index=int(session.get("current_question_index") or 1),
        total=int(session.get("questions_total") or 1),
        employee_options=employee_options,
    )
    _send_and_store_message(
        int(session["chat_id"]),
        text,
        dialog_id=session.get("dialog_id"),
        author="System",
    )
    return True


def start_survey_for_context(
    *,
    template_id: int,
    chat_id: int,
    dialog_id: int | None,
    appeal_id: int | None = None,
    trigger_source: str = SURVEY_TRIGGER_MANUAL,
) -> dict | None:
    session = database.start_survey_session(
        template_id=template_id,
        chat_id=chat_id,
        dialog_id=dialog_id,
        appeal_id=appeal_id,
        trigger_source=trigger_source,
    )
    if not session:
        return None
    _send_survey_question(session)
    return session


def start_survey_after_rating(dialog_id: int, appeal_id: int | None = None) -> dict | None:
    templates = database.list_active_survey_templates(SURVEY_TRIGGER_AFTER_CSAT)
    if not templates:
        return None
    dialog = database.get_chat_dialog(dialog_id)
    if not dialog:
        return None
    for template in templates:
        if database.survey_session_exists(int(template["id"]), dialog_id, appeal_id):
            continue
        return start_survey_for_context(
            template_id=int(template["id"]),
            chat_id=int(dialog["chat_id"]),
            dialog_id=dialog_id,
            appeal_id=appeal_id,
            trigger_source=SURVEY_TRIGGER_AFTER_CSAT,
        )
    return None


def maybe_start_survey_after_employee_csat(dialog_id: int, appeal_id: int | None = None) -> dict | None:
    if not database.operator_csats_complete(dialog_id, appeal_id):
        return None
    return start_survey_after_rating(dialog_id, appeal_id)


def handle_survey_text_answer(message: telebot.types.Message) -> bool:
    if message.content_type != "text":
        return False
    session = database.get_active_survey_session(message.chat.id)
    if not session:
        return False
    question = session.get("current_question")
    if not question:
        database.complete_survey_session(int(session["id"]))
        return True
    employee_options = _survey_employee_options(session, question)
    result = parse_survey_answer(question, message.text or "", employee_options=employee_options)
    _persist_message(
        message,
        direction="incoming",
        section=None,
        dialog_id=session.get("dialog_id"),
    )
    if not result.valid:
        _send_and_store_message(
            message.chat.id,
            result.error_message or "РћС‚РІРµС‚ РЅРµ СЂР°СЃРїРѕР·РЅР°РЅ. РџРѕРїСЂРѕР±СѓР№С‚Рµ РµС‰Рµ СЂР°Р·.",
            dialog_id=session.get("dialog_id"),
            author="System",
        )
        return True
    database.save_survey_answer(session_id=int(session["id"]), question=question, answer=result)
    next_session = database.advance_survey_session(int(session["id"]))
    if next_session:
        _send_survey_question(next_session)
    else:
        _send_and_store_message(
            message.chat.id,
            "РЎРїР°СЃРёР±Рѕ, РѕС‚РІРµС‚С‹ СЃРѕС…СЂР°РЅРµРЅС‹.",
            dialog_id=session.get("dialog_id"),
            author="System",
        )
    return True


def start_manual_survey(
    template_id: int,
    *,
    bin_values: list[str] | None = None,
    dialog_ids: list[int] | None = None,
) -> dict:
    targets = database.resolve_survey_manual_targets(bin_values=bin_values, dialog_ids=dialog_ids)
    started: list[dict] = []
    skipped: list[dict] = []
    for target in targets:
        session = start_survey_for_context(
            template_id=template_id,
            chat_id=int(target["chat_id"]),
            dialog_id=int(target["dialog_id"]) if target.get("dialog_id") is not None else None,
            appeal_id=int(target["appeal_id"]) if target.get("appeal_id") is not None else None,
            trigger_source=SURVEY_TRIGGER_MANUAL,
        )
        if session:
            started.append({"session_id": session["id"], **target})
        else:
            skipped.append(target)
    return {"started": started, "skipped": skipped, "started_count": len(started), "skipped_count": len(skipped)}


def _periodic_survey_key(interval: str | None, now: datetime) -> str | None:
    normalized = (interval or "monthly").strip().lower()
    if normalized == "monthly":
        return now.strftime("%Y-%m")
    if normalized == "quarterly":
        quarter = ((now.month - 1) // 3) + 1
        return f"{now.year}-Q{quarter}"
    return None


def start_periodic_surveys(now: datetime | None = None) -> dict:
    current_time = now or datetime.now(timezone.utc)
    templates = database.list_active_survey_templates(SURVEY_TRIGGER_PERIODIC)
    targets = database.resolve_survey_manual_targets()
    started: list[dict] = []
    skipped: list[dict] = []
    for template in templates:
        period_key = _periodic_survey_key(template.get("periodic_interval"), current_time)
        if not period_key:
            continue
        trigger_source = f"{SURVEY_TRIGGER_PERIODIC}:{period_key}"
        for target in targets:
            session = start_survey_for_context(
                template_id=int(template["id"]),
                chat_id=int(target["chat_id"]),
                dialog_id=int(target["dialog_id"]) if target.get("dialog_id") is not None else None,
                appeal_id=None,
                trigger_source=trigger_source,
            )
            payload = {"template_id": int(template["id"]), "period": period_key, **target}
            if session:
                started.append({"session_id": session["id"], **payload})
            else:
                skipped.append(payload)
    return {"started": started, "skipped": skipped, "started_count": len(started), "skipped_count": len(skipped)}


